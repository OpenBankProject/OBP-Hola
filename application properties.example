server.port=8087
oauth2.public_url=https://oauth2.openbankproject.com/obp-oidc
obp.base_url=https://apisandbox.openbankproject.com
endpoint.path.prefix=${obp.base_url}/open-banking/v3.1
endpoint.path.prefix.v401=${obp.base_url}/open-banking/v4.0.1/aisp

logging.level.com.openbankproject=DEBUG

mtls.keyStore.path=file:///path/to/keystore.jks
mtls.keyStore.password=secretpassword
mtls.keyStore.alias=1
mtls.trustStore.path=file:///path/to/truststore.jks
mtls.trustStore.password=secretpassword

display_standards=UKOpenBanking,BerlinGroup,OBP-API
force_jws=None

server.servlet.session.cookie.name=HALO_SESSION

logo.bank.enabled=true
logo.bank.url=https://static.openbankproject.com/images/obp_logo.png

